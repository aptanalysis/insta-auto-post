# ── 네이버 쇼핑 검색 API (https://developers.naver.com/apps → 애플리케이션 등록 → "검색" API 선택)
# 비워두면 MOCK 모드(가짜 데이터)로 동작합니다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 데이터베이스 (libSQL/SQLite)
# 로컬/자체 서버: 파일 경로. Vercel 등 서버리스: Turso(https://turso.tech) URL + 토큰
DATABASE_URL=file:./data/app.db
DATABASE_AUTH_TOKEN=

# ── 웹 푸시 VAPID 키:  npm run vapid  으로 생성 후 붙여넣기
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ── 가격 체크 엔드포인트(/api/cron/check) 보호용 비밀값 (아무 긴 랜덤 문자열)
CRON_SECRET=

# ── (선택) 앱 접속 비밀번호. 설정하면 Basic 인증 (아이디는 아무거나)
APP_PASSWORD=

# ── 알림 기준: '평소 가격'(최근 30일 중앙값) 대비 몇 % 이상 싸지면 알림 (상품별로 변경 가능)
DEFAULT_DROP_PCT=5

# ── 앱의 공개 URL (알림 클릭 시 이동 경로 생성용, 선택)
APP_URL=http://localhost:3000
